<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        AI 智能工单管理系统 - 父 POM
        6 模块单体架构，详见 ADR-0026。
        根 POM 仅声明模块、依赖版本，不直接构建产物。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.ticket</groupId>
    <artifactId>ai-ticket-system</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>ai-ticket-system</name>
    <description>AI 智能工单管理系统（单体架构）</description>

    <modules>
        <module>ticket-common</module>
        <module>ticket-security</module>
        <module>ticket-system</module>
        <module>ticket-ticket</module>
        <module>ticket-ai</module>
        <module>ticket-web</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 三方依赖版本（Spring Boot parent 未托管的部分） -->
        <mybatis-plus.version>3.5.5</mybatis-plus.version>
        <jjwt.version>0.12.5</jjwt.version>
        <!--
            ticket 10 引入：Apache EasyExcel —— ticket 列表 .xlsx 导出（ADR-0030）。
            选 3.3.x 与 Spring Boot 3 / JDK 17 兼容（3.3+ 起基于 poi 5.x，模块化好）。
        -->
        <easyexcel.version>3.3.4</easyexcel.version>
        <!--
            Redisson 3.27.x 与 Spring Boot 3.2.x 兼容（redisson-spring-boot-starter
            自动装配 RedissonClient Bean，无需手工 Config）。
            ticket 09 引入：工单详情读路径 cache-aside 防击穿分布式锁。
        -->
        <redisson.version>3.27.2</redisson.version>
        <!--
            Spring AI 1.x BOM —— Spring AI 1.0.0-M6 与 Spring Boot 3.2.x 兼容。
            ticket-ai 通过 spring-ai-bom 管理 spring-ai-openai-spring-boot-starter 版本。
            注意：1.0.0 GA 后 Spring AI 改了 artifact 命名（spring-ai-openai-spring-boot-starter
            仅发布到 1.0.0-M6），所以锁定到 M6。后续如升级到 1.1+ / 2.x 需同步切到
            spring-ai-starter-model-openai。
        -->
        <spring-ai.version>1.0.0-M6</spring-ai.version>

        <!-- 模块版本统一管理 -->
        <ticket-common.version>1.0.0</ticket-common.version>
        <ticket-security.version>1.0.0</ticket-security.version>
        <ticket-system.version>1.0.0</ticket-system.version>
        <ticket-ticket.version>1.0.0</ticket-ticket.version>
        <ticket-ai.version>1.0.0</ticket-ai.version>
        <ticket-web.version>1.0.0</ticket-web.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 模块内部依赖 -->
            <dependency>
                <groupId>com.ticket</groupId>
                <artifactId>ticket-common</artifactId>
                <version>${ticket-common.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ticket</groupId>
                <artifactId>ticket-security</artifactId>
                <version>${ticket-security.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ticket</groupId>
                <artifactId>ticket-system</artifactId>
                <version>${ticket-system.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ticket</groupId>
                <artifactId>ticket-ticket</artifactId>
                <version>${ticket-ticket.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ticket</groupId>
                <artifactId>ticket-ai</artifactId>
                <version>${ticket-ai.version}</version>
            </dependency>

            <!-- MyBatis Plus（Spring Boot 3 专用 starter） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!--
                JJWT 0.12.x — API / 实现 / Jackson 序列化三件套拆分，
                impl 与 jackson 仅运行期需要（详见 ticket 02）。
            -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>

            <!--
                Spring AI 1.x BOM —— 统一管理 spring-ai-* 系列版本。
                ticket-ai 模块通过此 BOM 解析 spring-ai-openai-spring-boot-starter。
            -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--
                Redisson Spring Boot 3 starter（ticket 09 引入）。
                自动装配 RedissonClient Bean，提供 RLock / RBucket / 等高级 Redis API。
            -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>

            <!--
                Apache EasyExcel（ticket 10 引入）—— 工单列表 Excel 导出（ADR-0030）。
                比 Apache POI 内存友好，几万行不爆内存；写流式输出。
            -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>easyexcel</artifactId>
                <version>${easyexcel.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                    业务模块 pom 中**不要**显式启用 spring-boot-maven-plugin（详见 ADR-0026），
                    避免 repackage 冲突。仅 ticket-web 在自己的 pom 中启用。
                -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>

                <!--
                    maven-compiler-plugin：显式启用 Lombok 注解处理器。
                    Eclipse 通过 .factorypath 自带处理；命令行 mvn 编译必须显式声明
                    annotationProcessorPaths，否则 javac 找不到 @Data / @Getter / @Setter
                    生成的 getter / setter，导致 Lombok 注解类（如 SysUser / LoginUser / TicketVO）
                    调用方编译失败（"找不到方法 getId()" 等）。
                    强制指定 Lombok 版本（与 .factorypath 一致 = 1.18.32，兼容 JDK 21）。
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>1.18.32</version>
                            </path>
                        </annotationProcessorPaths>
                        <compilerArgs>
                            <arg>-Amapstruct.defaultComponentModel=default</arg>
                            <arg>-Amapstruct.defaultInjectionStrategy=constructor</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>