<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        ticket-web - 唯一入口模块（详见 ADR-0026）
        包含 Spring Boot 启动类与 application.yml，
        所有业务模块作为 compile 依赖聚合到一个 fat jar。
    -->
    <parent>
        <groupId>com.ticket</groupId>
        <artifactId>ai-ticket-system</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>ticket-web</artifactId>
    <packaging>jar</packaging>

    <name>ticket-web</name>
    <description>Controller 层 / API 接口 / 请求参数处理</description>

    <dependencies>
        <!-- 业务模块全部依赖 -->
        <dependency>
            <groupId>com.ticket</groupId>
            <artifactId>ticket-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ticket</groupId>
            <artifactId>ticket-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ticket</groupId>
            <artifactId>ticket-system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ticket</groupId>
            <artifactId>ticket-ticket</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ticket</groupId>
            <artifactId>ticket-ai</artifactId>
        </dependency>

        <!-- Lombok — 注解处理器不依赖传递，每个使用模块显式声明 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Security 测试支持（MockMvc 安全断言） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            H2 内存库 — 集成测试替代 MySQL（本机无 Docker，Testcontainers 不可用）。
            仅 test scope，不进 fat jar。
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

<!--
            ticket 09 —— 工单详情缓存集成测试用 Testcontainers Redis。
            与现有"本机无 Docker"默认假设不冲突：TicketCacheIntegrationTest
            用 @EnabledIfSystemProperty("test.integration", "true") 标记，
            默认 mvn test 不启用；CI 或本机有 Docker 时传 -Dtest.integration=true 启用。
            testcontainers 1.19.8 + junit-jupiter（（503 Service Unavailable） 通用 Redis 镜像）。
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>1.19.8</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>1.19.8</version>
            <scope>test</scope>
        </dependency>

        <!--
            ticket 11 —— Knife4j API 文档（ADR-0032）。
            内含 springdoc-openapi-starter-webmvc-ui，提供 /v3/api-docs 与 /swagger-ui 服务。
            knife4j.production=false（默认）开启 /doc.html 增强 UI。
            注：@Tag / @Operation / @Schema 等 swagger 注解由 starter 传递依赖提供
            （springdoc-openapi-starter-common → swagger-annotations-jakarta），无需显式声明。
        -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                ticket-web 是唯一启用 spring-boot-maven-plugin 的模块，
                业务模块的 pom 中不要启用（详见 ADR-0026）。
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>