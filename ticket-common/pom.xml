<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        ticket-common - 公共工具模块
        提供 Result 包装、全局异常处理、通用枚举与工具类。
        所有业务模块的依赖底层，不依赖任何其他业务模块。
    -->
    <parent>
        <groupId>com.ticket</groupId>
        <artifactId>ai-ticket-system</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>ticket-common</artifactId>
    <packaging>jar</packaging>

    <name>ticket-common</name>
    <description>公共工具类 / 常量 / 统一返回结果 / 全局异常 / 公共枚举</description>

    <dependencies>
        <!-- Spring Web 提供 ResponseEntity 与 Jackson 序列化能力 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Hibernate Validator 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Spring Security Core —— 仅为了在 GlobalExceptionHandler 中识别
            @PreAuthorize 抛出的 AccessDeniedException，转成 403。
            ticket-security 模块本身已传递依赖，这里显式声明让 common 模块自给自足。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>

        <!-- Lombok 简化样板代码 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- 单元测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>